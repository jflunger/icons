<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs Icon Search on http://localhost:8765 on a Mac. Replace /Users/YOU/icon-search
     with the checkout path. The server runs the weekly ingest itself. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.iconsearch.server</string>
  <key>WorkingDirectory</key><string>/Users/YOU/icon-search</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/icon-search/.venv/bin/uvicorn</string>
    <string>iconsearch.server:app</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8765</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/Library/Logs/iconsearch/server.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/iconsearch/server.log</string>
</dict>
</plist>
